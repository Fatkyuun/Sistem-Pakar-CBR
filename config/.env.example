# ============================================================
# config/.env — SALINAN CONT OH. Salin berkas ini menjadi config/.env
# lalu isi nilai aslinya. config/.env TIDAK di-commit (lihat .gitignore).
# Kredensial database hanya boleh ada di sini, tidak di kode.
# ============================================================

APP_NAME="Sistem Pakar Penyakit Pernapasan (CBR)"
APP_ENV=development

# Database (MySQL 8 / MariaDB via Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sistem_pakar_cbr
DB_USER=root
DB_PASS=

# Kebijakan login (rate limiting percobaan gagal, disimpan di log_aktivitas)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
